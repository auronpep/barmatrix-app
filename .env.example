# BarMatrix frontend environment contract.
# Source refs: SRC-0019, SRC-0021.
#
# Current stack: Next.js 16 App Router on Vercel. The API is a separate
# Hostinger Node.js service at api.barmatrix.app backed by Hostinger MySQL.
# Keep backend secrets in the API/Hostinger environment, not this frontend repo.

# Public frontend -> API base URL. Set this in Vercel for staging/production.
NEXT_PUBLIC_API_URL=https://api.barmatrix.app

# Public client-side provider keys. Keep secret keys in provider/API runtimes.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Mirror the PostHog project token here for browser analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Public Sentry browser/server DSN for Next.js error monitoring.
NEXT_PUBLIC_SENTRY_DSN=

# Optional Sentry source-map upload settings for CI/Vercel builds.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

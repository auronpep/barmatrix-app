# BarMatrix frontend environment contract.
# Source refs: SRC-0019, SRC-0021.
#
# Current stack: Next.js 16 App Router on Vercel. The API is a separate
# Hostinger Node.js service at api.barmatrix.app backed by Hostinger MySQL.
# Keep backend secrets in the API/Hostinger environment, not this frontend repo.

# Public frontend -> API base URL. Set this in Vercel for staging/production.
NEXT_PUBLIC_API_URL=https://api.barmatrix.app

# Planned client-side provider keys. Leave blank until the provider projects
# are provisioned and recorded in C:/BMO/docs/questions-to-resolve.md.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

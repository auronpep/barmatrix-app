# Hostinger Apache config for Next.js static export.
# Goals:
#   1. Resolve clean URLs like /pricing/ → /pricing/index.html.
#   2. Force HTTPS so Stripe and Clerk widgets work later.
#   3. Cache static assets aggressively; never cache HTML.
#   4. Send the static 404.html on missing routes.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # If the request maps to a directory, append a trailing slash so the
  # DirectoryIndex resolves to index.html.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

  # Static assets and existing files: serve as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise serve the static 404.
  RewriteRule ^ /404.html [L]
</IfModule>

# Aggressive caching for hashed Next.js assets, no caching for HTML.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Sane security headers — Stripe and Clerk add more later via meta tags.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
